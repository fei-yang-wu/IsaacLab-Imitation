# C++
**/cmake-build*/
**/build*/
**/*.so
**/*.log*

# Omniverse
**/*.dmp
**/.thumbs

# Python
.DS_Store
**/*.egg-info/
**/__pycache__/
**/.pytest_cache/
**/*.pyc
**/*.pb

# Docker/Singularity
**/*.sif
docker/cluster/exports/
docker/.container.cfg

# IDE
**/.idea/
**/.vscode/
# Worktrees and session state. Note this is `/*`, not `/.claude/`: git cannot
# re-include anything under an excluded DIRECTORY, so the negation below only
# works if the entries are excluded individually.
/.claude/*
# Skills are shared guidance, not local state -- they are how another agent
# learns a repo-specific procedure, so they belong in the repo.
!/.claude/skills/
/.codex/worktrees/
# Don't ignore the top-level .vscode directory as it is
# used to configure VS Code settings
!.vscode

# Outputs
**/output/*
**/outputs/*
**/videos/*
**/wandb/*
**/.neptune/*
docker/artifacts/
*.tmp

# Doc Outputs
**/docs/_build/*
**/generated/*

# Isaac-Sim packman
_isaac_sim*
_repo
_build
.lastformat

# RL-Games
**/runs/*
**/logs/*
**/recordings/*

# Pre-Trained Checkpoints
/.pretrained_checkpoints/
/checkpoints/

# Teleop Recorded Dataset
/datasets/
/offline_dataset_cache/

# Tests (repo-root scratch dir only -- an unanchored `tests/` also
# swallowed source/*/tests/, which silently dropped real test files)
/tests/

# Docker history
.isaac-lab-docker-history

# TacSL sensor
**/tactile_record/*
**/gelsight_r15_data/*
scripts/rsl_rl/__pycache__/cli_args.cpython-311.pyc

# data folder
data/*
!data/README.md
!data/unitree

.omc/

# Generated motion label and rollout artifacts
data/**/*.npz
data/unitree/*_hl_diffsr/
# pixi environments
.pixi/*
!.pixi/config.toml

ipmd/
scratchpad/
