# Resolved inputs for the 2026-07-23 LAFAN1 one-motion planner-capacity study.
# Source this from the driver. Every value is `: "${VAR:=default}"` so a caller
# (e.g. the ICE entry) can pre-export container-side overrides that win.
#
# Study: does the DiffSR latent interface reduce planner-training complexity vs
# explicit full-body-chunk and EE-chunk interfaces, on walk1_subject1?
#   (1) iso-performance: fewer planner params to reach a fixed MPJPE/survival target
#   (2) iso-parameter:  better MPJPE/survival at matched planner params
# Oracle policy: converged oracles + oracle-normalized MPJPE (user, 2026-07-23).

: "${MOTION_NAME:=walk1_subject1}"
: "${MANIFEST:=data/lafan1/manifests/g1_lafan1_walk1_subject1_manifest.json}"

# ---- Frozen low-level oracles (converged, seed 0, post joint-order-fix) ----
# On ICE these repo-relative logs/ paths resolve via the persistent logs bind
# once the checkpoints are staged into <ISAACLAB>/logs/downloaded_checkpoints/.
: "${LATENT_LOW_LEVEL_CHECKPOINT:=logs/downloaded_checkpoints/lafan1_latent_deterministic_5b_seed0/model_step_4525129728.pt}"
: "${LATENT_SKILL_CHECKPOINT:=logs/downloaded_checkpoints/lafan1_latent_deterministic_5b_seed0/skill_encoder/latest.pt}"
# Pinned to the explicit id, NOT `Isaac-Imitation-G1-Latent-v0`. On 2026-07-27
# that default id was re-pointed to the new `ImitationG1LatentStableEnvCfg`
# surface (SONIC recipe + legacy resets). Every latent row in this study --
# including the frozen oracle checkpoint above -- was produced on the previous
# strict surface, which now lives only behind this explicit id. Leaving the
# default here would silently evaluate a frozen checkpoint on a different
# environment. If this id ever fails to resolve, that is the correct loud
# failure: do not fall back to the default.
: "${LATENT_TASK:=Isaac-Imitation-G1-Latent-Strict-v0}"
: "${FBCHUNK_LOW_LEVEL_CHECKPOINT:=logs/downloaded_checkpoints/lafan1_fbchunk_5b_seed0/model_step_5000085504.pt}"
: "${EECHUNK_LOW_LEVEL_CHECKPOINT:=logs/downloaded_checkpoints/lafan1_eechunk_5b_seed0/model_step_5000085504.pt}"
# Reduced explicit interfaces (2026-07-28). Segment-1 checkpoints, deliberately:
# RLOpt only writes a checkpoint when an iteration crosses a save_interval
# boundary (base_class.py:_should_save_checkpoint) and never at end-of-training,
# so a resumed segment's tail is unwritable. These are 4.600B / 4.800B against
# FB/EE's 5.000B and latent's 4.525B -- all four inside a 4.5-5.0B band, and the
# study normalizes each planner by its own oracle.
: "${ROOT_QPOS_LOW_LEVEL_CHECKPOINT:=logs/downloaded_checkpoints/lafan1_rootqpos_5b_seed0/model_step_4600037376.pt}"
: "${ROOT_POINTS5_LOW_LEVEL_CHECKPOINT:=logs/downloaded_checkpoints/lafan1_rootpoints5_5b_seed0/model_step_4800135168.pt}"
: "${CHUNK_TASK:=Isaac-Imitation-G1-Strict-v0}"

# Latent reference dataset cache (name-bound, joint-order-safe).
: "${LATENT_DATASET_PATH:=data/lafan1/zarr/latent_walk1_subject1_corrected_8e95d557}"

# Converged-oracle plateau quality (training logs / wandb summary):
#   FB-chunk  MPJPE 34.1mm  ep_len 454
#   EE-chunk  MPJPE 41.3mm  ep_len 424
#   latent    MPJPE 45.6mm  ep_len 393
# Oracle-normalized MPJPE controls for this quality gap.
#
# ICE overrides (set by run_capacity_entry.py):
#   MANIFEST=/data/lafan1_corrected_8e95d557/manifests/g1_lafan1_manifest.json
#   LATENT_DATASET_PATH=/data/lafan1_corrected_8e95d557/g1_hl_diffsr
#   (walk1_subject1 restricted via --motion_name)
