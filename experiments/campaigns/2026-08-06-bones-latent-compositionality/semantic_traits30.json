{
  "schema": "semantic_phase_traits_v1",
  "activity_definition": {
    "locomotion": "Root locomotion without object interaction.",
    "manipulation": "Object or environment interaction without purposeful root locomotion.",
    "combined_loco_manip": "Purposeful locomotion while manipulating, carrying, or supporting an object.",
    "gesture": "Expressive or bodily action without object/environment manipulation.",
    "stationary": "Task phase is predominantly stationary.",
    "transition": "Short recovery, start, or stop interval between task activities."
  },
  "semantic_axes": {
    "locomoting": "The root intentionally translates or performs cyclic locomotion such as walking, running, or jumping.",
    "manipulating": "The arms or hands intentionally operate on, support, or carry an object or environmental control.",
    "object_loaded": "The intended behavior is holding, carrying, or supporting an object, including implicit props.",
    "torso_lowered": "The task intentionally places the torso in a stooped, crouched, or substantially forward-lowered posture.",
    "turning": "The task intentionally changes root heading or follows a curved path.",
    "moving_forward": "The root intentionally translates primarily forward in the actor's current heading frame.",
    "moving_backward": "The root intentionally translates primarily backward in the actor's current heading frame.",
    "moving_sideways": "The root intentionally translates primarily sideways or diagonally rather than straight forward/backward.",
    "jumping": "The body intentionally performs repeated or isolated jumps.",
    "slow_locomotion": "The described locomotion is explicitly slow or uses small deliberate steps.",
    "fast_locomotion": "The described locomotion is explicitly a run, panic escape, or otherwise fast.",
    "active_left_hand": "The left arm or hand is deliberately active in the task phase.",
    "active_right_hand": "The right arm or hand is deliberately active in the task phase.",
    "active_both_hands": "Both arms or hands are deliberately active in the task phase."
  },
