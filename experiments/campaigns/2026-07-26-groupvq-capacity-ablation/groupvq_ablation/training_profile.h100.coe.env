# H100 profile for the grouped-VQ capacity grid, approved by the user on
# 2026-07-26 after every H200 GPU on ice-gpu and coe-gpu was allocated (one
# free H200 cluster-wide) while coe-gpu had ~40 free H100s.
#
# Geometry is the H100 point proven by the 2026-07-22 BONES-SEED GPU/LR
# ablation arm `h100_e12288_lr1e3`, not the H200 profile's 16,384 envs: an
# 80 GB H100 cannot hold the 16,384-environment point.
#
# Consequence recorded deliberately: every arm of this grid, including the
# g64_c128 anchor, is re-run at this geometry. The 2026-07-22 H200 study at
# 16,384 envs is therefore a separate table and its `gumbel_multicat` run is
# NOT a row of this grid.
PROFILE_APPROVED=1
TRAIN_NUM_ENVS=12288
ROLLOUT_STEPS=12
MINIBATCH_SIZE=18432
ACTOR_LR=1.0e-3
ACTOR_LR_CAP=1.0e-3
CRITIC_LR=1.0e-3
LATENT_LR=3.0e-4
GPU_GRES=gpu:h100:1
PARTITION=coe-gpu
# Conservative: the 07-22 H100 5B runs sustained about 77-83k FPS at this
# geometry. One 14h segment therefore covers roughly 4.0B of the 5B cap.
ASSUMED_FPS=80000
SEGMENT_TRAIN_SECONDS=50400
FRAME_CAP=5000000000
